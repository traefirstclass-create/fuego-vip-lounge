rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins: a signed-in user may only check whether THEIR OWN uid is an admin
    // (used by admin.html to gate the dashboard UI after login) — they can't
    // list other admins or write to this collection at all; admin docs are
    // only ever added manually via the Firebase console.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
    }

    // Guest list: anyone can submit a signup; only signed-in admins can read, update, or delete
    match /guestList/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'contact', 'contactType', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.contact is string;
      allow read, update, delete: if isAdmin();
    }

    // Site content: public can read (landing page loads it); only signed-in admins can write
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Member records: authenticated users may create and read their own membership data;
    // admins may also manually add records (e.g. backfilling signups collected elsewhere),
    // which is why doc IDs aren't required to match request.auth.uid for admin writes.
    match /members/{memberId} {
      allow create: if request.auth != null
                    && (request.auth.uid == memberId || isAdmin())
                    && request.resource.data.keys().hasAll(['name', 'email', 'membershipActive', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.membershipActive is bool;
      allow read, update, delete: if request.auth != null && (request.auth.uid == memberId || isAdmin());
    }

    // Members-only gallery content: only signed-in users may read gallery items; only admins may manage them
    match /galleryItems/{itemId} {
      allow read: if request.auth != null;
      allow write, update, delete: if isAdmin();
    }

    // Portal members: paying monthly members who signed up via the private post-payment link.
    // They may create their own account record; only they (or an admin) may read it; only
    // admins can change tier/cap/etc, so a member can't grant themselves extra visits.
    match /portalMembers/{memberId} {
      allow create: if request.auth != null
                    && request.auth.uid == memberId
                    && request.resource.data.keys().hasAll(['name', 'email', 'tier', 'visitCap', 'membershipStartDate', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.tier is string
                    && request.resource.data.visitCap is int;
      allow read: if request.auth != null && (request.auth.uid == memberId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Visits: door-scan check-ins. Only admin/staff (signed in via admin.html) can log a visit;
    // a member can read their own visit history, admins can read all.
    match /visits/{visitId} {
      allow create: if isAdmin()
                    && request.resource.data.keys().hasAll(['memberId', 'scannedAt'])
                    && request.resource.data.memberId is string;
      allow read: if isAdmin() || (request.auth != null && resource.data.memberId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // VIP reservation system —————————————————————————————————————————

    // Events: public can read (the floor plan needs to list/select nights).
    // All writes go through the secured /api/admin/create-event server route
    // (Firebase Admin SDK, which bypasses these rules entirely) rather than
    // direct client writes, so this stays read-only for every client.
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Event-specific booth inventory: public can read status/price/capacity
    // (no guest PII lives on this document, ever) so the floor plan can show
    // live availability. All mutations (holds, sales, admin release) happen
    // server-side via the Admin SDK, which bypasses these rules.
    match /eventBooths/{eventBoothId} {
      allow read: if true;
      allow write: if false;
    }

    // Reservations hold guest name/phone/payment info — never public. Only
    // signed-in admins may read them (for the admin.html reservations tab);
    // all writes happen server-side via the Admin SDK (checkout hold
    // creation, Stripe webhook confirmation, admin release actions).
    match /reservations/{reservationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
