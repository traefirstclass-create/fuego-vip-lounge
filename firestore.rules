rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guest list: anyone can submit a signup; only signed-in admins can read, update, or delete
    match /guestList/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'contact', 'contactType', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.contact is string;
      allow read, update, delete: if request.auth != null;
    }

    // Site content: public can read (landing page loads it); only signed-in admins can write
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
