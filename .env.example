# Public site URL (used to build Stripe success/cancel redirect URLs)
NEXT_PUBLIC_SITE_URL=https://www.fuegoviplounge.com

# Stripe (server-side only — never prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin SDK service account (server-side only)
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=fuego-vip-lounge
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
